# WLB大作战 配置文件
# 复制为 config.yaml 并填入你的 API Key

app:
  name: WLB大作战
  host: 0.0.0.0
  port: 8000

# 大模型配置
llm:
  provider: deepseek
  deepseek:
    base_url: https://api.deepseek.com
    api_key: "YOUR_API_KEY_HERE"
    model: deepseek-chat
  kimi:
    base_url: https://api.moonshot.cn/v1
    api_key: ""
    model: moonshot-v1-8k
  qwen:
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    api_key: ""
    model: qwen-plus
  openai:
    base_url: https://api.openai.com/v1
    api_key: ""
    model: gpt-4o-mini
  ollama:
    base_url: http://localhost:11434/v1
    api_key: "ollama"
    model: qwen2.5:7b

# Crawler schedule
spider:
  enabled: true
  cron_hour: 2
  cron_minute: 0
  sources:
    smawiki: true
    nowcoder: true
    guokao: true
    shanghai_kao: true

# Database
db:
  path: data/app.db

# Resume file storage
storage:
  resume_dir: data/resumes
