# 秋招投递助手配置文件
# 复制为 config.yaml 并填入你的配置

app:
  name: WLB大作战
  host: 0.0.0.0
  port: 8000
  jwt_secret: "请在生产环境通过 JWT_SECRET 设置随机长字符串"
  jwt_expire_days: 30
  admin_emails: []

db:
  path: data/app.db

storage:
  avatar_dir: data/avatars
  supabase_url: ""
  supabase_service_role_key: ""
  supabase_bucket: avatars

jobs:
  excel_path: ""
